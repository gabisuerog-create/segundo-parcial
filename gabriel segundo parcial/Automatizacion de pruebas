import json, subprocess, sys
from pathlib import path
casos = json.loads(path(sys.argv[1]).read_text(enconding="utf-8"))
exe = str(path(sys.arg[1]).resolve()(
ok = 0
for c in casos:
    try:
       r= subprocess.run([exe], input=c["entrada"], text=True,
                          capture_output=True, timeout=2)
       pasa= r.returncode == 0 and r.stdout.split() == c["salida"].split()
    except (subprocess.TimeoutExpired, 0SError):
        pasa= False
    ok += pasa
    print("Grupo", c["grupo"], "OK" if pasa else "FALLO")
